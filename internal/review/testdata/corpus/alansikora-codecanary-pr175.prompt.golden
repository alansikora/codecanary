427: func TestToFixedThreads_PropagatesRationale(t *testing.T) {
428: 	resolutions := []ThreadResolution{
429: 		{Index: 0, Resolved: true, Reason: "code_change", Rationale: "dropped dead fields"},
430: 		{Index: 1, Resolved: false},
