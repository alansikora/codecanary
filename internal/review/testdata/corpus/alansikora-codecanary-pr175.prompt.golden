446: func TestExtractAckReason(t *testing.T) {
447: 	cases := []struct {
448: 		name string
449: 		body string
450: 		want string
451: 	}{
452: 		{"current marker", "<!-- codecanary:ack:rebutted -->\nKeeping open.", "rebutted"},
453: 		{"acknowledged", "<!-- codecanary:ack:acknowledged -->\nKeeping open.", "acknowledged"},
454: 		{"dismissed", "<!-- codecanary:ack:dismissed -->\nKeeping open.", "dismissed"},
455: 		{"legacy marker", "<!-- clanopy:ack:rebutted -->\nKeeping open.", "rebutted"},
456: 		{"no marker", "Some normal reply", ""},
457: 		{"no closing tag", "<!-- codecanary:ack:acknowledged with no closer", ""},
458: 		{"unknown reason", "<!-- codecanary:ack:unknown -->\n", "unknown"},
459: 	}
460: 	for _, tc := range cases {
461: 		t.Run(tc.name, func(t *testing.T) {
462: 			if got := extractAckReason(tc.body); got != tc.want {
463: 				t.Errorf("extractAckReason(%q) = %q, want %q", tc.body, got, tc.want)
464: 			}
465: 		})
466: 	}
467: }
