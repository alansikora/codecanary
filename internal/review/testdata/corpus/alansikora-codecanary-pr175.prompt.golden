362: func TestClassifyThreads_FullDiffForCrossFile(t *testing.T) {
363: 	threads := []ReviewThread{
364: 		{Path: "a.go", Line: 10, Body: "Issue in a.go"},
365: 	}
366: 	// Only b.go changed — finding's file (a.go) is not in the diff.
367: 	diff := "diff --git a/b.go b/b.go\n--- a/b.go\n+++ b/b.go\n@@ -5,3 +5,3 @@\n-old b\n+new b\n"
368: 
369: 	triaged := ClassifyThreads(threads, diff, diff, "bot", []string{"a.go", "b.go"}, nil)
370: 
371: 	if triaged[0].Class != TriageCrossFileChange {
372: 		t.Fatalf("expected TriageCrossFileChange, got %d", triaged[0].Class)
373: 	}
374: 	if !strings.Contains(triaged[0].FileDiff, "b.go") {
375: 		t.Error("FileDiff for TriageCrossFileChange should contain the full PR diff")
376: 	}
377: }
