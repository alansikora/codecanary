17: // runGH runs a gh command and returns stdout; on failure, the returned error
18: // includes gh's stderr so upstream API messages surface in logs instead of just
19: // "exit status 1".
20: func runGH(label string, args ...string) ([]byte, error) {
21: 	cmd := exec.Command("gh", args...)
22: 	var stderr bytes.Buffer
23: 	cmd.Stderr = &stderr
24: 	out, err := cmd.Output()
25: 	if err != nil {
26: 		msg := strings.TrimSpace(stderr.String())
27: 		if msg == "" {
28: 			return nil, fmt.Errorf("%s: %w", label, err)
29: 		}
30: 		return nil, fmt.Errorf("%s: %s: %w", label, msg, err)
31: 	}
32: 	return out, nil
33: }
